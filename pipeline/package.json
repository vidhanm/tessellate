{
  "name": "@saral/pipeline",
  "version": "0.1.0",
  "private": true,
  "description": "Framework-free OpenAI task pipeline for Saral (ITR filing assistant). Every model call the product makes lives here.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schemas": "./src/schemas/index.ts",
    "./client": "./src/client.ts",
    "./fixtures/*": "./fixtures/*"
  },
  "files": [
    "src",
    "fixtures",
    "README.md"
  ],
  "scripts": {
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "demo": "tsx scripts/demo.ts"
  },
  "keywords": [
    "itr",
    "openai",
    "structured-outputs",
    "tax"
  ],
  "license": "MIT",
  "dependencies": {
    "openai": "^7.5.0",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
